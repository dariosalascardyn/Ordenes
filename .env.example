# Copia este archivo como .env y configura el mismo secreto compartido con Users y Tickets.
SERVER_PORT=8083
EVENTOS_URL=http://localhost:8084
TICKETS_URL=http://localhost:8081
DB_URL=jdbc:mysql://localhost:3307/db_ordenes?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
MYSQL_HOST_PORT=3307
MYSQL_ALLOW_EMPTY_PASSWORD=yes
JWT_SECRET_BASE64=REEMPLAZAR_POR_EL_SECRETO_BASE64_COMPARTIDO_CON_USERS_Y_TICKETS
JWT_ISSUER=eventpass-users
